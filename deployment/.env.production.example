# Production Environment Variables for Beget VPS
# Domain: классный-фокус.рф (Punycode: xn----7sb1acdcpkxafxk9g.xn--p1ai)

NODE_ENV=production
PORT=3000

# Frontend URL (Punycode is required for Node.js CORS headers)
FRONTEND_URL=https://xn----7sb1acdcpkxafxk9g.xn--p1ai

# PostgreSQL Database (Connected to Docker container on port 5034)
DATABASE_URL=postgresql://video_user:YOUR_STRONG_DB_PASSWORD@localhost:5034/video_courses_db

# Security & Authentication Secrets (Generate using: openssl rand -base64 48)
JWT_SECRET=GENERATE_STRONG_RANDOM_SECRET_MIN_48_CHARS
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_STRONG_RANDOM_SECRET_MIN_48_CHARS
SESSION_SECRET=GENERATE_STRONG_SESSION_SECRET_MIN_48_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO Storage Configuration
# Uses the main domain over HTTPS so that browser uploads/downloads avoid Mixed Content issues
S3_REGION=us-east-1
S3_ENDPOINT=https://xn----7sb1acdcpkxafxk9g.xn--p1ai
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=GENERATE_STRONG_MINIO_SECRET_KEY
S3_BUCKET=videos-prod
S3_FORCE_PATH_STYLE=true

# FFmpeg Paths on Ubuntu Linux
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VIDEO_TEMP_DIR=/var/tmp/video-processing

# Manifest & Streaming Token TTLs (in seconds)
SEGMENT_URL_TTL_SECONDS=7200
PLAYBACK_MANIFEST_TOKEN_TTL_SECONDS=600

# YooKassa (ЮKassa) Payment Gateway Configuration
# Live Shop ID from YooKassa Merchant Dashboard
YOOKASSA_SHOP_ID=YOUR_LIVE_YOOKASSA_SHOP_ID
# Live Secret Key from YooKassa Merchant Dashboard
YOOKASSA_SECRET_KEY=YOUR_LIVE_YOOKASSA_SECRET_KEY

