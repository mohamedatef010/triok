NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://video_user:your_secure_db_password@localhost:5034/video_courses_db

# Security & JWT Tokens (Generate strong random secrets in production: openssl rand -base64 48)
JWT_SECRET=your_super_strong_jwt_access_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_key_min_32_chars
SESSION_SECRET=your_super_strong_session_secret_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO Object Storage
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=your_secure_s3_secret_key
S3_BUCKET=videos-dev
S3_FORCE_PATH_STYLE=true

# Video Processing (FFmpeg)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_TEMP_DIR=C:/temp/video-processing
SEGMENT_URL_TTL_SECONDS=7200
PLAYBACK_MANIFEST_TOKEN_TTL_SECONDS=600

# YooKassa (ЮKassa) Payment Gateway Configuration
YOOKASSA_SHOP_ID=your_yookassa_shop_id
YOOKASSA_SECRET_KEY=your_yookassa_secret_key

